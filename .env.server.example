# Copy to .env.server (ignored by Git). Do not paste real keys in chat or source.
# Only widget TEST keys are accepted. Live payment keys are rejected at startup.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
CHECKOUT_SITE_URL=http://127.0.0.1:5173/
CHECKOUT_HOST=127.0.0.1
PORT=4010
CHECKOUT_DB_PATH=server/data/checkout.sqlite

# KRW: independent 1,000 KRW/unit test fixture, NOT currency conversion.
# USD: requires USD test MID/widget keys and an explicit payment variant key.
TOSS_TEST_CURRENCY=KRW
TOSS_PAYMENT_VARIANT_KEY=DEFAULT
TOSS_AGREEMENT_VARIANT_KEY=AGREEMENT
